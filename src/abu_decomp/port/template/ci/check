#!/bin/sh
# Local gate (port format 1): format check, debug build, ctest. Builds on the rig only (W memory guard).
set -eu
cd "$(dirname "$0")/.."
ci/format-check
cmake --preset debug >/dev/null
: "${JOBS:?JOBS is unset: run under Terminal admission (it sets JOBS), the width this build takes}"
nice cmake --build --preset debug -j"$JOBS"
ctest --preset debug
